default_platform(:ios)

platform :ios do

  desc "Upload pre-built IPA to App Store Connect"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_API_KEY_ID"],
      issuer_id: ENV["APPSTORE_API_ISSUER_ID"],
      key_content: ENV["APPSTORE_API_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    ipa_path = Dir.glob("../build/ios/ipa/*.ipa").first
    UI.user_error!("No IPA found in build/ios/ipa/. Run 'flutter build ipa' first.") unless ipa_path

    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Upload pre-built IPA to TestFlight"
  lane :testflight_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_API_KEY_ID"],
      issuer_id: ENV["APPSTORE_API_ISSUER_ID"],
      key_content: ENV["APPSTORE_API_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    ipa_path = Dir.glob("../build/ios/ipa/*.ipa").first
    UI.user_error!("No IPA found in build/ios/ipa/. Run 'flutter build ipa' first.") unless ipa_path

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

end
